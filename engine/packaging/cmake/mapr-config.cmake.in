# mapr-config.cmake - CMake config for find_package(mapr)
# Generated by MAPR build system

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Check for required components
if(mapr_FIND_REQUIRED_THREADS)
    find_dependency(Threads REQUIRED)
endif()

# Check version compatibility
set(PACKAGE_VERSION @PROJECT_VERSION@)
if("${PACKAGE_VERSION}" VERSION_LESS "${mapr_FIND_VERSION}")
    if(mapr_FIND_REQUIRED)
        message(FATAL_ERROR "Found MAPR ${PACKAGE_VERSION} but required ${mapr_FIND_VERSION}")
    else()
        return()
    endif()
endif()

# Provide imported targets
if(NOT TARGET mapr::mapr)
    include("${CMAKE_CURRENT_LIST_DIR}/mapr-targets.cmake")
endif()

# Version variables
set(mapr_VERSION ${PACKAGE_VERSION})
set(mapr_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(mapr_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(mapr_VERSION_PATCH @PROJECT_VERSION_PATCH@)

# Feature flags
set(mapr_HAS_SIMD @MAPR_BUILD_SIMD@)
set(mapr_HAS_AVX2 @MAPR_HAS_AVX2@)
set(mapr_HAS_AVX512 @MAPR_HAS_AVX512@)
set(mapr_HAS_NEON @MAPR_HAS_NEON@)

# Include directories
set(mapr_INCLUDE_DIRS "${CMAKE_CURRENT_LIST_DIR}/../../include")

# Provide pkg-config like variables
set(mapr_LIBRARIES mapr::mapr)
set(mapr_STATIC_LIBRARIES mapr::mapr_static)

message(STATUS "Found MAPR ${mapr_VERSION}")